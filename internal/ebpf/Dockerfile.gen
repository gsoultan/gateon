# Dockerfile.gen — reproducible build environment for generating the eBPF/XDP
# bpf2go bindings. The host (e.g. macOS) cannot compile BPF objects because it
# lacks a BPF-target clang and Linux kernel/libbpf headers; this container does.
#
# Usage (from repo root):
#   make ebpf-docker
# which mounts the repo at /src and runs `go generate ./internal/ebpf/...`,
# producing gateon_ebpf_bpfel.go / gateon_ebpf_bpfeb.go and the embedded *.o
# objects in internal/ebpf/. Commit those generated files.
#
# Pinned to the exact go.mod minimum. The base image sets GOTOOLCHAIN=local, so
# a tag older than the go directive is a hard error rather than a silent
# toolchain download -- which is how this went stale: go.mod moved to 1.27.0 and
# codegen started failing with "go.mod requires go >= 1.27.0".
FROM golang:1.27.0-bookworm

# clang/llvm provide the BPF-target compiler + llvm-strip; libbpf-dev provides
# <bpf/bpf_helpers.h>; linux-headers + libc headers provide <linux/*.h>.
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang \
        llvm \
        libbpf-dev \
        libelf-dev \
        linux-libc-dev \
        make \
    && rm -rf /var/lib/apt/lists/*

# <asm/*.h>, which <linux/types.h> includes, lives under the multiarch triplet
# rather than on clang's default search path. gcc-multilib used to supply it and
# was listed above, but that package exists only on amd64 — on an arm64 host
# (any Apple silicon Mac, which is the case this file was written for) the build
# failed outright with "Package 'gcc-multilib' has no installation candidate".
#
# Naming both triplets is portable in a way that package could not be: clang
# ignores the entry that is not present, so the same image builds on either.
ENV CPATH=/usr/include/aarch64-linux-gnu:/usr/include/x86_64-linux-gnu

# bpf2go shells out to `clang` and `llvm-strip` by default.
ENV BPF2GO_CC=clang
ENV BPF2GO_STRIP=llvm-strip

WORKDIR /src

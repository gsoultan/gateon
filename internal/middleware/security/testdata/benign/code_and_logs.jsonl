# Pasted source code, stack traces, configuration and logs.
# Developer tools, issue trackers, paste services, CI dashboards and support
# desks all receive this traffic as their core function. mem:dlp is explicit that
# structural-disclosure rules sit at PL2 precisely because a site whose job is to
# display a stack trace serves them legitimately, so these cases are the ones
# that decide whether PL2 is deployable.
{"name": "paste shell script", "method": "POST", "path": "/pastes", "headers": {"Content-Type": "application/json"}, "body": "{\"lang\":\"sh\",\"content\":\"#!/bin/sh\\nset -eu\\nfor f in ./logs/*.log; do\\n  gzip -9 \\\"$f\\\"\\ndone\\necho done\\n\"}", "note": "a paste service receiving a shell script; every metacharacter present and all of it legitimate", "profiles": ["issue_tracker"], "scope_paths": ["/pastes", "/tickets", "/tickets/*", "/api/v1/issues", "/api/v1/pages", "/api/v1/docs", "/api/v1/reviews/*", "/api/v1/builds/*", "/api/v1/releases", "/upload"], "scope_fields": ["content", "body", "md", "subject", "manifest", "expr", "selector", "dsn", "html", "note"]}

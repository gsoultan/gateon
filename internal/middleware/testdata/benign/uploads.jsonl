# Multipart form uploads.
# Multipart bodies carry filenames, content types and binary magic bytes through
# a parser that has to get boundary handling exactly right. Filenames are the
# risk: a document called "Q3 report (final) - Doe, Jane.pdf" is ordinary, and
# every character in it is one a path-traversal or command-injection rule watches.
{"name": "single file upload", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW"}, "body": "------WebKitFormBoundary7MA4YWxkTrZu0gW\r\nContent-Disposition: form-data; name=\"file\"; filename=\"report.pdf\"\r\nContent-Type: application/pdf\r\n\r\n%PDF-1.7\n1 0 obj\n<< /Type /Catalog >>\nendobj\n\r\n------WebKitFormBoundary7MA4YWxkTrZu0gW--\r\n", "note": "the plainest possible file upload"}
{"name": "upload with text fields", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW"}, "body": "------WebKitFormBoundary7MA4YWxkTrZu0gW\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nQuarterly results\r\n------WebKitFormBoundary7MA4YWxkTrZu0gW\r\nContent-Disposition: form-data; name=\"file\"; filename=\"q3.pdf\"\r\nContent-Type: application/pdf\r\n\r\n%PDF-1.7\r\n------WebKitFormBoundary7MA4YWxkTrZu0gW--\r\n", "note": "a file plus metadata fields, the normal upload form"}
{"name": "upload filename with spaces", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"Quarterly Report Q3 2026.pdf\"\r\nContent-Type: application/pdf\r\n\r\n%PDF-1.7\r\n--X--\r\n", "note": "spaces in a filename, which is what people actually name files"}
{"name": "upload filename with parentheses", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"invoice (2).pdf\"\r\nContent-Type: application/pdf\r\n\r\n%PDF-1.7\r\n--X--\r\n", "note": "the duplicate-download name every browser generates"}
{"name": "upload filename with comma", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"Doe, Jane - CV.pdf\"\r\nContent-Type: application/pdf\r\n\r\n%PDF-1.7\r\n--X--\r\n", "note": "surname-first naming with a comma and a hyphen"}
{"name": "upload filename with ampersand", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"terms & conditions.pdf\"\r\nContent-Type: application/pdf\r\n\r\n%PDF-1.7\r\n--X--\r\n", "note": "an ampersand in a document name"}
{"name": "upload filename with apostrophe", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"O'Brien contract.pdf\"\r\nContent-Type: application/pdf\r\n\r\n%PDF-1.7\r\n--X--\r\n", "note": "an apostrophe inside a quoted filename parameter"}
{"name": "upload filename with hash", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"invoice #4821.pdf\"\r\nContent-Type: application/pdf\r\n\r\n%PDF-1.7\r\n--X--\r\n", "note": "a hash-numbered invoice"}
{"name": "upload filename with plus", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"c++ notes.md\"\r\nContent-Type: text/markdown\r\n\r\n# notes\r\n--X--\r\n", "note": "plus signs in a filename"}
{"name": "upload filename with multiple dots", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"backup.2026.09.04.tar.gz\"\r\nContent-Type: application/gzip\r\n\r\n\u001f\b\r\n--X--\r\n", "note": "a dated archive with a double extension"}
{"name": "upload rfc5987 filename", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"report.pdf\"; filename*=UTF-8''%E5%A0%B1%E5%91%8A%E6%9B%B8.pdf\r\nContent-Type: application/pdf\r\n\r\n%PDF-1.7\r\n--X--\r\n", "note": "RFC 5987 extended filename for a Japanese document name"}
{"name": "upload unicode filename raw", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"Übersicht 2026.xlsx\"\r\nContent-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\r\n\r\nPK\u0003\u0004\r\n--X--\r\n", "note": "a raw UTF-8 filename, which browsers send despite the spec"}
{"name": "upload png magic bytes", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"avatar\"; filename=\"me.png\"\r\nContent-Type: image/png\r\n\r\nPNG\r\n\u001a\n\u0000\u0000\u0000\rIHDR\u0000\u0000\u0000\u0001\u0000\u0000\u0000\u0001\b\u0006\u0000\u0000\u0000\u001f\u0015Ä\r\n--X--\r\n", "note": "real PNG magic bytes; binary in a body must not be read as an obfuscated payload"}
{"name": "upload jpeg magic bytes", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"photo\"; filename=\"IMG_4821.JPG\"\r\nContent-Type: image/jpeg\r\n\r\nÿØÿà\u0000\u0010JFIF\u0000\u0001\u0001\u0001\u0000H\u0000H\u0000\u0000\r\n--X--\r\n", "note": "JPEG magic bytes and a camera-style filename"}
{"name": "upload csv", "method": "POST", "path": "/import", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"customers.csv\"\r\nContent-Type: text/csv\r\n\r\nid,name,email\n1,\"Doe, Jane\",jane@example.com\n2,\"O'Brien, Sean\",sean@example.ie\n\r\n--X--\r\n", "note": "a CSV import with quoted fields containing commas and apostrophes"}
{"name": "upload csv with formula text", "method": "POST", "path": "/import", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"budget.csv\"\r\nContent-Type: text/csv\r\n\r\nitem,qty,total\nwidgets,10,=B2*4.5\n\r\n--X--\r\n", "note": "a spreadsheet export containing a formula cell; CSV injection is a downstream concern, not a reason to refuse the upload"}
{"name": "upload svg", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"logo\"; filename=\"logo.svg\"\r\nContent-Type: image/svg+xml\r\n\r\n<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\"><path d=\"M12 2 L22 22 H2 Z\"/></svg>\r\n--X--\r\n", "note": "an SVG logo; XML markup that a design tool uploads constantly", "known_fp": {"1": "SVG is XML, so a logo upload inspects as a script-bearing document. Also deliberately not a default exception: an SVG served back as image/svg+xml executes its script in the origin's context, so exempting it globally would trade a false positive for stored XSS. Operators who accept SVG uploads scope the exception to that upload route.", "2": "SVG is XML, so a logo upload inspects as a script-bearing document. Also deliberately not a default exception: an SVG served back as image/svg+xml executes its script in the origin's context, so exempting it globally would trade a false positive for stored XSS. Operators who accept SVG uploads scope the exception to that upload route."}}
{"name": "upload json fixture", "method": "POST", "path": "/import", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"fixtures.json\"\r\nContent-Type: application/json\r\n\r\n{\"users\":[{\"id\":1,\"name\":\"Jane\"}]}\r\n--X--\r\n", "note": "a JSON fixture file uploaded to a test tool"}
{"name": "upload markdown", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"README.md\"\r\nContent-Type: text/markdown\r\n\r\n# Gateway\n\nRun `make build` then `./gateon`.\r\n--X--\r\n", "note": "a README upload containing backticked commands", "profiles": ["issue_tracker"], "known_fp": {"2": "developer-tool traffic at paranoia 2 only. The issue_tracker profile is scoped to this deployment's paths and fields (scope_paths/scope_fields), which closes every one of these at paranoia 1. PL2 admits additional rules the profile's set does not name, so the remaining gap is the profile's rule list rather than the scoping mechanism. Adding to that list is a gwaf change: it decides which detections a class of application legitimately trips, and the evidence for that lives upstream where every consumer benefits."}, "scope_paths": ["/pastes", "/tickets", "/tickets/*", "/api/v1/issues", "/api/v1/pages", "/api/v1/docs", "/api/v1/reviews/*", "/api/v1/builds/*", "/api/v1/releases", "/upload"], "scope_fields": ["content", "body", "md", "subject", "manifest", "expr", "selector", "dsn", "html", "note"]}
{"name": "upload no content type", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"file\"; filename=\"notes.txt\"\r\n\r\njust some notes\r\n--X--\r\n", "note": "a part with no Content-Type, which the spec permits"}
{"name": "upload multiple files", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=X"}, "body": "--X\r\nContent-Disposition: form-data; name=\"files\"; filename=\"a.txt\"\r\nContent-Type: text/plain\r\n\r\nfirst\r\n--X\r\nContent-Disposition: form-data; name=\"files\"; filename=\"b.txt\"\r\nContent-Type: text/plain\r\n\r\nsecond\r\n--X--\r\n", "note": "a multi-select upload posting several parts under one name"}
{"name": "upload with quoted boundary", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=\"simple-boundary\""}, "body": "--simple-boundary\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a.txt\"\r\nContent-Type: text/plain\r\n\r\nhello\r\n--simple-boundary--\r\n", "note": "a quoted boundary parameter, which RFC 2046 allows"}
{"name": "upload long boundary", "method": "POST", "path": "/upload", "headers": {"Content-Type": "multipart/form-data; boundary=---------------------------265001916915724"}, "body": "-----------------------------265001916915724\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a.txt\"\r\nContent-Type: text/plain\r\n\r\nhello\r\n-----------------------------265001916915724--\r\n", "note": "the long dashed boundary Firefox generates"}

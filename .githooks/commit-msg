#!/bin/sh
# Strip AI co-authorship trailers from every commit message.
#
# The prose rule was not enough: an agent harness instructed to add
# "Co-Authored-By: Claude ..." added it to 45 commits on main, which reached
# GitHub and had to be rewritten out of public history. A rule that lives only
# in prose is a rule that depends on whoever is reading it that day.
#
# The vendor list is deliberately broad. The first version of this hook matched
# Claude alone, and a "Co-authored-by: Junie <junie@jetbrains.com>" trailer from
# a different agent walked straight past it into an ancestor of every branch.
# Agents are interchangeable; the rule is about tooling, not about one vendor.
#
# Matching is on agent name *and* vendor domain rather than on Co-Authored-By
# wholesale, because a human co-author is a real contributor and must survive.
msg="$1"
[ -f "$msg" ] || exit 0

vendors='claude|anthropic|junie|jetbrains\.com|copilot|cursor|devin|cognition|codex|chatgpt|openai|gemini|jules|aider|windsurf|codeium|sourcegraph'
pattern="^((co-)?(authored|assisted)-by:.*($vendors)|.*generated with \\[?($vendors)|🤖 generated with)"

# grep -c prints a count and exits 1 when that count is zero, so an "|| echo 0"
# fallback appends a *second* zero and the arithmetic test then fails. Take the
# printed count and normalise it instead.
before=$(grep -ciE "$pattern" "$msg" 2>/dev/null)
case "$before" in ''|*[!0-9]*) before=0 ;; esac
[ "$before" -eq 0 ] && exit 0

tmp="$msg.tmp.$$"
grep -viE "$pattern" "$msg" > "$tmp" && mv "$tmp" "$msg"

# Collapse the blank lines the removal leaves behind.
tmp="$msg.tmp.$$"
awk 'BEGIN{b=0} /^[[:space:]]*$/{b++; next} {while(b>0 && NR>1){print ""; b--}; b=0; print} END{}' "$msg" > "$tmp" && mv "$tmp" "$msg"

echo "commit-msg: removed $before AI attribution line(s)" >&2
exit 0

[
  {
    "id": "add-header",
    "type": "headers",
    "config": {
      "set_response_X-Test-Gateon": "true"
    }
  },
  {
    "id": "block-ip",
    "type": "ipfilter",
    "config": {
      "deny_list": "1.2.3.4"
    }
  },
  {
    "id": "block-ip-127-0-0-1",
    "name": "Auto-Block: 127.0.0.1",
    "type": "ipfilter",
    "config": {
      "deny_list": "127.0.0.1"
    }
  },
  {
    "id": "cors-allow-all",
    "type": "cors",
    "config": {
      "allowed_headers": "Content-Type,Authorization",
      "allowed_methods": "GET,POST,PUT,DELETE,OPTIONS",
      "allowed_origins": "*"
    }
  },
  {
    "id": "grpc-web-mw",
    "type": "grpcweb",
    "config": {
      "allowed_origins": "*"
    }
  },
  {
    "id": "pgadmin-headers",
    "type": "headers",
    "config": {
      "set_request_X-Scheme": "https",
      "set_request_X-Script-Name": "/pgadmin4"
    }
  },
  {
    "id": "ratelimit-strict",
    "type": "ratelimit",
    "config": {
      "average": "10",
      "burst": "20"
    }
  },
  {
    "id": "strip-pgadmin",
    "type": "stripprefix",
    "config": {
      "prefixes": "/pgadmin4"
    }
  },
  {
    "id": "strip-synology",
    "type": "stripprefix",
    "config": {
      "prefixes": "/synology"
    }
  },
  {
    "id": "trust-headers",
    "type": "forwardedheaders",
    "config": {
      "trust_forward_header": "true"
    }
  },
  {
    "id": "waf-blocking",
    "type": "waf",
    "config": {
      "anomaly_threshold": "5",
      "audit_only": "false",
      "lfi": "true",
      "rce": "true",
      "sqli": "true",
      "xss": "true"
    }
  },
  {
    "id": "waf-full",
    "type": "waf",
    "config": {
      "anomaly_threshold": "5",
      "audit_only": "false",
      "lfi": "true",
      "rce": "true",
      "sqli": "true",
      "xss": "true"
    }
  }
]
[Unit]
Description=Gateon - API Gateway and Reverse Proxy
Documentation=https://github.com/gateon/gateon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gateon
Group=gateon
ExecStart=/usr/bin/gateon
Restart=on-failure
RestartSec=5s

# Config: place global.json, routes.json, etc. in /etc/gateon
WorkingDirectory=/var/lib/gateon
Environment=GLOBAL_CONFIG_FILE=/etc/gateon/global.json

# Override with: systemctl edit gateon
# Environment=PORT=8080

# State and config directories. systemd creates them if missing and re-applies
# the *DirectoryMode on every start, defaulting to 0755 -- which made the
# database and global.json's directory listable and traversable by every local
# account. Keep these in step with internal/install (a test holds them there).
StateDirectory=gateon
StateDirectoryMode=0700
ConfigurationDirectory=gateon
ConfigurationDirectoryMode=0750

# Its own account, holding only the capabilities it uses (ADR 0019):
# CAP_NET_BIND_SERVICE for entrypoints below 1024, and CAP_BPF with
# CAP_NET_ADMIN for eBPF (ADR 0018) -- CAP_NET_ADMIN also lets HA move the
# virtual IP. Ambient, so the process holds them without being root; the
# bounding set is the most it, or anything it runs, can ever have. CAP_PERFMON
# and CAP_SYS_RESOURCE are gone: the programs load without either.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN
# Kernels before 5.11 charge BPF maps to RLIMIT_MEMLOCK, which a process that
# is not root cannot raise for itself.
LimitMEMLOCK=infinity

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=-/etc/gateon -/var/lib/gateon

[Install]
WantedBy=multi-user.target

[
  {
    "id": "dev-headers",
    "name": "Dev response headers",
    "type": "headers",
    "config": {
      "set_response_X-Served-By": "gateon-dev"
    }
  },
  {
    "id": "cors-allow-all",
    "name": "CORS (permissive, dev only)",
    "type": "cors",
    "config": {
      "allowed_origins": "*",
      "allowed_methods": "GET,POST,PUT,DELETE,OPTIONS",
      "allowed_headers": "Content-Type,Authorization"
    }
  },
  {
    "id": "waf-protect",
    "name": "WAF (blocking)",
    "type": "waf",
    "config": {
      "sqli": "true",
      "xss": "true",
      "lfi": "true",
      "rce": "true",
      "anomaly_threshold": "5",
      "audit_only": "false"
    }
  },
  {
    "id": "ratelimit-dev",
    "name": "Rate limit (dev)",
    "type": "ratelimit",
    "config": {
      "average": "20",
      "burst": "40"
    }
  },
  {
    "id": "strip-api",
    "name": "Strip /api prefix",
    "type": "stripprefix",
    "config": {
      "prefixes": "/api"
    }
  },
  {
    "id": "security-headers",
    "name": "Security headers (recommended preset)",
    "type": "security_headers",
    "config": {
      "preset": "recommended"
    }
  },
  {
    "id": "compress",
    "name": "Compress responses over 1 KB",
    "type": "compress",
    "config": {
      "min_response_body_bytes": "1024"
    }
  },
  {
    "id": "request-id",
    "name": "Request ID",
    "type": "request_id",
    "config": {}
  },
  {
    "id": "inflight-api",
    "name": "At most 50 in-flight requests per client",
    "type": "inflightreq",
    "config": {
      "amount": "50",
      "per_ip": "true"
    }
  },
  {
    "id": "breaker-api",
    "name": "Circuit breaker (50% errors over 10 requests)",
    "type": "circuit_breaker",
    "config": {
      "error_threshold": "0.5",
      "min_requests": "10"
    }
  },
  {
    "id": "retry-twice",
    "name": "Retry idempotent requests twice",
    "type": "retry",
    "config": {
      "attempts": "2"
    }
  },
  {
    "id": "strip-canary",
    "name": "Strip /canary prefix",
    "type": "stripprefix",
    "config": {
      "prefixes": "/canary"
    }
  }
]
